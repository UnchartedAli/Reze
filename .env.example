# ====================================================================
#  Reze - environment template.   cp .env.example .env   then edit.
#  NEVER commit .env. Anyone with REZE_SESSION_STRING controls your account.
#  Empty values fall back to the built-in defaults.
# ====================================================================

# --- Telegram (required) ------------------------------------------------
# Create an app at https://my.telegram.org -> API development tools
REZE_API_ID=0
REZE_API_HASH=
# Your own numeric Telegram user id. Only this account can run commands.
REZE_OWNER_ID=0
# Portable session. Generate once, locally:  python scripts/generate_session.py
REZE_SESSION_STRING=
# Optional: phone for the interactive login prompt, e.g. +15551234567
REZE_PHONE=
# File session used when no session string is set
REZE_SESSION_PATH=data/reze.session
# Optional proxy: socks5://user:pass@host:1080  or  http://host:8080
REZE_PROXY=

# --- Storage -------------------------------------------------------------
REZE_DATA_DIR=data
REZE_DATABASE_URL=sqlite:///data/reze.db

# --- Web panel -----------------------------------------------------------
REZE_WEB_HOST=127.0.0.1
REZE_WEB_PORT=8080
# Behind nginx/Caddy with HTTPS, e.g. https://reze.example.com
REZE_PUBLIC_URL=
REZE_WEB_TRUST_PROXY=false
REZE_ALLOWED_ORIGINS=
REZE_PANEL_USERNAME=admin
# Set exactly ONE of the two. Prefer the hash:  python scripts/generate_hash.py
REZE_PANEL_PASSWORD_HASH=
REZE_PANEL_PASSWORD=
# Replace with a long random value:  python -c "import secrets; print(secrets.token_hex(32))"
REZE_SECRET_KEY=reze-super-secret-key-change-me-in-production
REZE_ALLOW_INSECURE_DEFAULT_LOGIN=false
REZE_SESSION_TTL_SECONDS=14400
REZE_WEB_MAX_BODY_BYTES=262144

# --- General -------------------------------------------------------------
REZE_TIMEZONE=UTC
REZE_LOG_LEVEL=INFO
REZE_DEFAULT_PREFIX=.
REZE_THEME=CYBER
REZE_COMPACT_MODE=false
REZE_CLOCK_INTERVAL_MINUTES=1
REZE_PRESENCE_INTERVAL_SECONDS=60

# --- Command limits ------------------------------------------------------
REZE_MAX_PURGE_LIMIT=100
REZE_MAX_TAGALL_LIMIT=50
REZE_SEARCH_SCAN_LIMIT=200

# --- Background tasks ----------------------------------------------------
REZE_TASK_CONCURRENCY=2
REZE_TASK_QUEUE_LIMIT=8
REZE_TASK_TIMEOUT_SECONDS=300

# --- Media studio (FFmpeg must be on PATH, or set REZE_FFMPEG_PATH) -------
REZE_MEDIA_WORK_DIR=
REZE_MEDIA_MAX_INPUT_MB=20
REZE_MEDIA_MAX_OUTPUT_MB=48
REZE_MEDIA_QUALITY=82
REZE_FFMPEG_PATH=
# Background removal provider key (https://www.remove.bg)
REZE_REMOVEBG_API_KEY=

# --- AI gateway (optional) -----------------------------------------------
# Providers: openai | anthropic | gemini | openai-compatible
REZE_AI_PROVIDER=
REZE_AI_MODEL=
REZE_AI_API_KEY=
REZE_AI_BASE_URL=
# Comma-separated fallback providers
REZE_AI_FALLBACK=
REZE_AI_TIMEOUT_SECONDS=60
REZE_AI_MAX_INPUT_CHARS=12000
REZE_AI_MAX_OUTPUT_TOKENS=900
REZE_AI_VISION=auto

# --- Automation ----------------------------------------------------------
REZE_AUTOMATION_ENABLED=true
REZE_AUTOMATION_MAX_RULES=50
REZE_AUTOMATION_RUNS_PER_HOUR=30

# --- Command safety (optional; read directly from the environment) -------
# Only YOUR account can run commands. Set true to let others use public/admin commands.
# REZE_PUBLIC_COMMANDS=false
# .exec is OFF by default. Enabling it gives your account shell access on this host.
# REZE_ENABLE_EXEC=false
# Max chats per .broadcast run (1-500)
# REZE_BROADCAST_MAX=100
# Netscape cookies.txt for yt-dlp (some Instagram/Facebook posts need a login)
# REZE_YTDLP_COOKIES=
# Optional GitHub token for .github (higher API rate limit)
# REZE_GITHUB_TOKEN=
